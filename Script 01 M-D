class GestureAnalyzer:
    def __init__(self):
        self.mp_hands = mp.solutions.hands
        self.hands = self.mp_hands.Hands(static_image_mode=True, max_num_hands=1)

    def count_fingers(self, image):
        rgb_img = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
        results = self.hands.process(rgb_img)
        if not results.multi_hand_landmarks:
            logger.info("No hands detected in image.")
            return 0
        
        landmarks = results.multi_hand_landmarks[0].landmark
        finger_tips = [8, 12, 16, 20]
        count = 0
        for tip in finger_tips:
            if landmarks[tip].y < landmarks[tip - 2].y:
                count += 1
        logger.info(f"Detected {count} raised fingers.")
        return count
import argparse
import sys
from src.image_loader import ImageLoader
from src.preprocessor import Preprocessor
from src.ocr_engine import OCREngine
from src.gesture_detector import GestureAnalyzer
from src.logger import get_logger

logger = get_logger()

def main():
    parser = argparse.ArgumentParser(description="OptiGesture Engine CLI")
    parser.add_argument("--image", type=str, required=True, help="Path to input image")
    parser.add_argument("--task", type=str, choices=["ocr", "gesture", "both"], default="both")
    
    args = parser.parse_args()
    
    try:
        img = ImageLoader.load_image(args.image)
        
        if args.task in ["ocr", "both"]:
            prep = Preprocessor.process_for_ocr(img)
            text = OCREngine.extract_text(prep)
            print("\n--- OCR EXTRACTED TEXT ---")
            print(text if text else "[No readable text found]")
            
        if args.task in ["gesture", "both"]:
            analyzer = GestureAnalyzer()
            count = analyzer.count_fingers(img)
            print("\n--- GESTURE DETECTION RESULT ---")
            print(f"Fingers Counted: {count}")
            
    except Exception as e:
        logger.error(f"Pipeline Execution Failed: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
